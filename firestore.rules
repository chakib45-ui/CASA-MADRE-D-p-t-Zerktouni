rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.email == 'chakib.45@gmail.com');
    }

    // Profils utilisateurs et sous-collections catalogue
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /articles/{articleId} {
        allow read, write: if isAuthenticated();
      }

      match /config/{configDoc} {
        allow read, write: if isAuthenticated();
      }
    }

    // Collection inventaire partagée pour l'ensemble des utilisateurs autorisés
    match /inventory/{articleId} {
      allow read, write: if isAuthenticated();
    }

    // Collection des approbations et rôles utilisateurs
    match /user_approvals/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Journal d'historique des accès et connexions
    match /access_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Configuration globale et sécurité (ex: code PIN d'autorisation)
    match /app_config/{configId} {
      allow read, write: if isAuthenticated();
    }

    // Refus par défaut pour toutes les requêtes non authentifiées
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
