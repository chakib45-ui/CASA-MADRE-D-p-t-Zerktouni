# Port du serveur de développement Node / Express (Défaut: 3000)
PORT=3000

# URL de l'application hôte
APP_URL="http://localhost:3000"

# ==============================================================================
# Configuration Client Firebase Dédié
# Récupérez ces clés dans : Console Firebase > Paramètres du projet > Général > Vos applications
# ==============================================================================
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="casa-madre-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="casa-madre-app"
VITE_FIREBASE_STORAGE_BUCKET="casa-madre-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Administrateur Principal & Sécurité
VITE_ADMIN_EMAIL="chakib.45@gmail.com"
